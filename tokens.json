{
  "$description": "Sumber tunggal token desain MIRA. Jangan edit dist/ secara manual; ubah file ini lalu jalankan `npm run build`. Palet diambil dari mira/frontend/src/theme.ts (SIMRS).",
  "color": {
    "mira": {
      "50": "#f0fdf4",
      "100": "#dcfce7",
      "200": "#bbf7d0",
      "300": "#86efac",
      "400": "#4ade80",
      "500": "#22c55e",
      "600": "#16a34a",
      "700": "#00730D",
      "800": "#005009",
      "900": "#012e11"
    },
    "slate": {
      "50": "#f8fafc",
      "100": "#f1f5f9",
      "200": "#e2e8f0",
      "300": "#cbd5e1",
      "400": "#94a3b8",
      "500": "#64748b",
      "600": "#475569",
      "700": "#334155",
      "800": "#1e293b",
      "900": "#0f172a"
    },
    "white": "#ffffff",
    "status": {
      "kritis": { "fg": "#b91c1c", "bg": "#fef2f2", "border": "#fecaca", "solid": "#b91c1c", "on-solid": "#ffffff", "fg-dark": "#fca5a5" },
      "waspada": { "fg": "#b45309", "bg": "#fffbeb", "border": "#fde68a", "solid": "#b45309", "on-solid": "#ffffff", "fg-dark": "#fcd34d" },
      "normal": { "fg": "#15803d", "bg": "#f0fdf4", "border": "#bbf7d0", "solid": "#15803d", "on-solid": "#ffffff", "fg-dark": "#86efac" },
      "info": { "fg": "#1d4ed8", "bg": "#eff6ff", "border": "#bfdbfe", "solid": "#1d4ed8", "on-solid": "#ffffff", "fg-dark": "#93c5fd" }
    }
  },
  "semantic": {
    "light": {
      "background": "{color.white}",
      "foreground": "{color.slate.700}",
      "card": "{color.white}",
      "card-foreground": "{color.slate.700}",
      "popover": "{color.white}",
      "popover-foreground": "{color.slate.700}",
      "primary": "{color.mira.700}",
      "primary-foreground": "{color.white}",
      "secondary": "{color.slate.100}",
      "secondary-foreground": "{color.slate.900}",
      "muted": "{color.slate.100}",
      "muted-foreground": "{color.slate.600}",
      "accent": "{color.mira.50}",
      "accent-foreground": "{color.mira.800}",
      "destructive": "{color.status.kritis.solid}",
      "destructive-foreground": "{color.white}",
      "border": "{color.slate.200}",
      "input": "{color.slate.500}",
      "ring": "{color.mira.700}"
    },
    "dark": {
      "background": "{color.slate.900}",
      "foreground": "{color.slate.100}",
      "card": "{color.slate.800}",
      "card-foreground": "{color.slate.100}",
      "popover": "{color.slate.800}",
      "popover-foreground": "{color.slate.100}",
      "primary": "{color.mira.400}",
      "primary-foreground": "{color.mira.900}",
      "secondary": "{color.slate.800}",
      "secondary-foreground": "{color.slate.100}",
      "muted": "{color.slate.800}",
      "muted-foreground": "{color.slate.400}",
      "accent": "{color.mira.900}",
      "accent-foreground": "{color.mira.200}",
      "destructive": "{color.status.kritis.fg-dark}",
      "destructive-foreground": "{color.slate.900}",
      "border": "{color.slate.700}",
      "input": "{color.slate.500}",
      "ring": "{color.mira.400}"
    }
  },
  "font": {
    "sans": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "heading": "Outfit, Inter, system-ui, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "weight-heading": "700",
    "weight-medium": "500"
  },
  "radius": {
    "xs": "2px",
    "sm": "4px",
    "md": "8px",
    "lg": "16px",
    "xl": "32px",
    "default": "8px"
  },
  "spacing": {
    "xs": "10px",
    "sm": "12px",
    "md": "16px",
    "lg": "20px",
    "xl": "32px"
  },
  "shadow": {
    "xs": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
    "sm": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1)",
    "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1)"
  },
  "contrast": {
    "$description": "Pasangan yang wajib lolos. min 4.5 = teks normal (WCAG 2.1 AA 1.4.3); min 3 = komponen non-teks (1.4.11).",
    "pairs": [
      ["light.foreground", "light.background", 4.5],
      ["light.foreground", "color.slate.50", 4.5],
      ["light.muted-foreground", "light.background", 4.5],
      ["light.muted-foreground", "light.muted", 4.5],
      ["light.primary-foreground", "light.primary", 4.5],
      ["light.primary", "light.background", 4.5],
      ["light.secondary-foreground", "light.secondary", 4.5],
      ["light.accent-foreground", "light.accent", 4.5],
      ["light.destructive-foreground", "light.destructive", 4.5],
      ["light.input", "light.background", 3],
      ["light.ring", "light.background", 3],
      ["dark.foreground", "dark.background", 4.5],
      ["dark.card-foreground", "dark.card", 4.5],
      ["dark.muted-foreground", "dark.background", 4.5],
      ["dark.muted-foreground", "dark.muted", 4.5],
      ["dark.primary-foreground", "dark.primary", 4.5],
      ["dark.primary", "dark.background", 4.5],
      ["dark.secondary-foreground", "dark.secondary", 4.5],
      ["dark.accent-foreground", "dark.accent", 4.5],
      ["dark.destructive-foreground", "dark.destructive", 4.5],
      ["dark.input", "dark.background", 3],
      ["dark.ring", "dark.background", 3],
      ["color.status.kritis.fg", "color.status.kritis.bg", 4.5],
      ["color.status.kritis.fg", "color.white", 4.5],
      ["color.status.kritis.on-solid", "color.status.kritis.solid", 4.5],
      ["color.status.kritis.fg-dark", "color.slate.900", 4.5],
      ["color.status.waspada.fg", "color.status.waspada.bg", 4.5],
      ["color.status.waspada.fg", "color.white", 4.5],
      ["color.status.waspada.on-solid", "color.status.waspada.solid", 4.5],
      ["color.status.waspada.fg-dark", "color.slate.900", 4.5],
      ["color.status.normal.fg", "color.status.normal.bg", 4.5],
      ["color.status.normal.fg", "color.white", 4.5],
      ["color.status.normal.on-solid", "color.status.normal.solid", 4.5],
      ["color.status.normal.fg-dark", "color.slate.900", 4.5],
      ["color.status.info.fg", "color.status.info.bg", 4.5],
      ["color.status.info.fg", "color.white", 4.5],
      ["color.status.info.on-solid", "color.status.info.solid", 4.5],
      ["color.status.info.fg-dark", "color.slate.900", 4.5],
      ["color.mira.800", "color.mira.50", 4.5],
      ["color.white", "color.mira.800", 4.5]
    ]
  }
}
